rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['magicPoints', 'quizIndex', 'transformedItems', 'lastUpdated'])
        && data.keys().size() <= 11 // Allow optional fields
        && data.magicPoints is int && data.magicPoints >= 0
        && data.quizIndex is int && data.quizIndex >= 0
        && data.transformedItems is list
        && (data.transformedItems.size() == 0 || data.transformedItems[0] is string)
        && (data.get('hasFinished', false) is bool)
        && data.lastUpdated == request.time;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() 
        && request.query.limit <= 20
        && (request.query.orderBy.hasFinished == 'DESC' || !('hasFinished' in request.query.orderBy))
        && request.query.orderBy.magicPoints == 'DESC';
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) 
        && isValidUserProfile(incoming())
        && (
          // Action: Any progress update
          incoming().diff(existing()).affectedKeys().hasOnly(['magicPoints', 'quizIndex', 'transformedItems', 'lastUpdated', 'displayName', 'photoURL'])
        );
      allow delete: if false; 
    }
  }
}
